{
    "name": "mj-zana/view-twig",
    "description": "Twig templates for mj-zana/view",
    "type": "library",
    "keywords": ["zana", "view", "twig", "templates"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/view": "^2.1",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "mj-zana/translation": "^2.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\View\\Twig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\View\\Twig\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.3.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.3.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.3.0" } } },
        { "type": "path", "url": "../zana-http", "options": { "symlink": true, "versions": { "mj-zana/http": "2.3.0" } } },
        { "type": "path", "url": "../zana-routing", "options": { "symlink": true, "versions": { "mj-zana/routing": "2.3.0" } } },
        { "type": "path", "url": "../zana-translation", "options": { "symlink": true, "versions": { "mj-zana/translation": "2.3.0" } } },
        { "type": "path", "url": "../zana-view", "options": { "symlink": true, "versions": { "mj-zana/view": "2.3.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
